{
  "name": "habit-tracker",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "npm run dev -w server",
    "dev:web": "npm run dev -w client",
    "db:local": "npm run db:local -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client"
  },
  "engines": {
    "node": "24.x"
  }
}
