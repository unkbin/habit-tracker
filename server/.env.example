# Copy to .env and adjust for your machine. Never commit .env.

# Matches docker-compose.yml.
DATABASE_URL="postgresql://habits:habits@localhost:5432/habits"

PORT=3000
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Frontend origin(s) allowed to call the API, comma-separated. Vite's dev server by default.
CORS_ORIGINS="http://localhost:5173"
# Used to build links in emails.
APP_URL="http://localhost:5173"
# "/auth" when the frontend calls the API directly; "/api/auth" if it proxies /api/* to the API.
COOKIE_PATH="/auth"
# Number of proxies in front of the API (1 on Render/Railway).
TRUST_PROXY=0

# Leave empty in development to print emails to the console.
RESEND_API_KEY=
EMAIL_FROM=
