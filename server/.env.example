# Copy to .env and adjust for your machine. Never commit .env.

# Matches docker-compose.yml. Without Docker, run `npm run db:local` and use instead:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
#   DATABASE_POOL_MAX=1
DATABASE_URL="postgresql://habits:habits@localhost:5432/habits"

PORT=3000
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Frontend origin(s) allowed to call the API, comma-separated. Vite's dev server by default.
CORS_ORIGINS="http://localhost:5173"
# Used to build links in emails.
APP_URL="http://localhost:5173"
# The web app calls the API through /api (Vite proxy in dev, host rewrite in prod), so the refresh
# cookie lives under /api/auth. Use "/auth" only if browsers call the API directly.
COOKIE_PATH="/api/auth"
# Number of proxies in front of the API (1 on Render/Railway).
TRUST_PROXY=0

# Leave empty in development to print emails to the console.
RESEND_API_KEY=
EMAIL_FROM=
